<!doctype html>
<html lang="<%= locale %>">
<head>
  <%- include('../partials/portfolio-head') %>
  <title><%= post.title %> — Yunus Emre Tom</title>
</head>
<body class="portfolio-v2">
<%- include('../partials/portfolio-nav') %>
<main class="shell inner-page">
  <a class="back-link" href="<%= routeFor('blog', locale) %>">← <%= t.backToBlog %></a>
  <p class="eyebrow">
    <%= post.category %> · <time datetime="<%= post.publishedAt %>"><%= post.publishedAt %></time> · <%= post.readingTime %> <%= t.minRead %>
  </p>
  <h1 class="page-title blog-post-title"><%= post.title %></h1>
  <% if (post.excerpt) { %>
    <p class="page-intro blog-post-lead"><%= post.excerpt %></p>
  <% } %>

  <% if (post.coverImageUrl) { %>
    <div class="project-detail-cover">
      <img
        src="<%= post.coverImageUrl %>"
        alt="<%= post.title %>"
        loading="lazy"
        style="width:100%;height:auto;object-fit:cover"
      >
    </div>
  <% } %>

  <article class="detail-panel blog-article">
    <% if (post.blocks && post.blocks.length) { %>
      <% post.blocks.forEach(block => { %>
        <% if (block.type === 'heading') { %>
          <h2 class="blog-section-heading"><%= block.text %></h2>
        <% } else { %>
          <p class="blog-paragraph"><%= block.text %></p>
        <% } %>
      <% }) %>
    <% } else if (post.excerpt) { %>
      <p class="blog-paragraph"><%= post.excerpt %></p>
    <% } %>

    <% if (post.tags && post.tags.length) { %>
      <div class="blog-tags-footer">
        <h3><%= locale === 'tr' ? 'Etiketler & konular' : 'Tags & topics' %></h3>
        <div class="tag-list">
          <% post.tags.forEach(tag => { %>
            <span><%= tag %></span>
          <% }) %>
        </div>
      </div>
    <% } %>
  </article>

  <% if (typeof relatedPosts !== 'undefined' && relatedPosts && relatedPosts.length) { %>
    <section class="blog-related">
      <div class="section-heading section-heading-row">
        <div>
          <p class="eyebrow"><%= locale === 'tr' ? 'DİĞER YAZILAR' : 'MORE ARTICLES' %></p>
          <h2><%= locale === 'tr' ? 'İlgili teknik notlar' : 'Related technical notes' %></h2>
        </div>
        <a class="text-link" href="<%= routeFor('blog', locale) %>"><%= t.backToBlog %> →</a>
      </div>
      <div class="blog-grid blog-related-grid">
        <% relatedPosts.forEach((rel, index) => { %>
          <article class="blog-card" style="--card-i: <%= index %>">
            <div class="blog-card-top">
              <span class="blog-badge"><%= rel.category %></span>
              <time class="blog-date" datetime="<%= rel.publishedAt %>"><%= rel.publishedAt %></time>
            </div>
            <h3 class="blog-card-heading">
              <a class="tile-title-link" href="<%= routeFor('blog', locale) + '/' + rel.slug %>"><%= rel.title %></a>
            </h3>
            <% if (rel.excerpt) { %>
              <p class="blog-card-excerpt"><%= rel.excerpt %></p>
            <% } %>
            <div class="tile-bottom blog-card-bottom">
              <span class="tile-status"><%= rel.readingTime %> <%= t.minRead %></span>
              <div class="tile-actions">
                <a class="tile-detail-link" href="<%= routeFor('blog', locale) + '/' + rel.slug %>"><%= t.readArticle %> ↗</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>
<%- include('../partials/portfolio-footer') %>
</body>
</html>

