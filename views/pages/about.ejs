<!doctype html><html lang="<%= locale %>"><head><%- include('../partials/portfolio-head') %><title><%= t.nav.about %> — Yunus Emre Tom</title></head><body class="portfolio-v2"><%- include('../partials/portfolio-nav') %><main class="shell inner-page">
<p class="eyebrow">01 / ABOUT</p><h1 class="page-title"><%= t.aboutTitle %></h1>
<div class="about-layout"><div class="about-copy"><p><%= profile.biography || t.aboutText %></p><p><%= t.aboutText2 %></p><div class="about-facts"><div><span>BASED IN</span><strong>Ankara, Türkiye</strong></div><div><span>UNIVERSITY</span><strong>Ankara Yıldırım Beyazıt Üniversitesi</strong></div><div><span>FOCUS</span><strong>UAV · Embedded · Electronics</strong></div></div></div><div class="portrait-placeholder"><img src="/imgs/profile.png" alt="Yunus Emre Tom" onerror="this.style.display='none'"><span>PROFILE / PORTRAIT</span></div></div>
<section class="focus-section"><div class="section-heading"><div><p class="eyebrow">02 / APPROACH</p><h2><%= locale === 'tr' ? 'Nasıl çalışıyorum?' : 'How I work' %></h2></div></div><div class="focus-grid"><article class="focus-card"><span class="card-index">01</span><h3><%= locale === 'tr' ? 'Araştır' : 'Research' %></h3><p><%= locale === 'tr' ? 'Problemi, gereksinimleri ve kısıtları anlamlandır.' : 'Understand the problem, requirements and constraints.' %></p></article><article class="focus-card"><span class="card-index">02</span><h3><%= locale === 'tr' ? 'Prototiple' : 'Prototype' %></h3><p><%= locale === 'tr' ? 'Fikirleri ölçülebilir ve test edilebilir sistemlere dönüştür.' : 'Turn ideas into measurable and testable systems.' %></p></article><article class="focus-card"><span class="card-index">03</span><h3><%= locale === 'tr' ? 'İyileştir' : 'Iterate' %></h3><p><%= locale === 'tr' ? 'Test sonuçları ve dokümantasyonla tasarımı geliştir.' : 'Improve the design through test results and documentation.' %></p></article></div></section>
</main><%- include('../partials/portfolio-footer') %></body></html>
