<!doctype html><html lang="<%= locale %>"><head><%- include('../partials/portfolio-head') %><title><%= t.nav.about %> — Yunus Emre Tom</title></head><body class="portfolio-v2"><%- include('../partials/portfolio-nav') %><main class="shell inner-page">
<p class="eyebrow">01 / ABOUT</p><h1 class="page-title"><%= site.aboutTitle || t.aboutTitle %></h1>
<div class="about-layout"><div class="about-copy"><p><%= profile.biography || t.aboutText %></p><% if (profile.additionalBiography || t.aboutText2) { %><p><%= profile.additionalBiography || t.aboutText2 %></p><% } %><div class="about-facts"><% if (profile.location) { %><div><span><%= locale === 'tr' ? 'KONUM' : 'BASED IN' %></span><strong><%= profile.location %></strong></div><% } %><% if (profile.university) { %><div><span><%= locale === 'tr' ? 'ÜNİVERSİTE' : 'UNIVERSITY' %></span><strong><%= profile.university %></strong></div><% } %><% if (profile.focusAreas && profile.focusAreas.length) { %><div><span><%= locale === 'tr' ? 'ODAK ALANLARI' : 'FOCUS' %></span><strong><%= profile.focusAreas.join(' · ') %></strong></div><% } %></div><% if (profile.cvUrl) { %><p><a class="button-quiet" href="<%= profile.cvUrl %>" target="_blank" rel="noopener"><%= locale === 'tr' ? 'Özgeçmişi görüntüle' : 'View CV' %> ↗</a></p><% } %></div><div class="portrait-placeholder"><% if (profile.portraitUrl) { %><img src="<%= profile.portraitUrl %>" alt="<%= profile.name || 'Profile portrait' %>"><% } else { %><img src="/imgs/profile.png" alt="<%= profile.name || 'Profile portrait' %>" onerror="this.style.display='none'"><% } %><span>PROFILE / PORTRAIT</span></div></div>
<% if (profile.skills && profile.skills.length) { %><section class="detail-panel"><h2><%= locale === 'tr' ? 'Yetkinlikler' : 'Skills' %></h2><div class="tag-list"><% profile.skills.forEach(skill => { %><span><%= skill %></span><% }) %></div></section><% } %>
<% if (profile.education && profile.education.length) { %><section class="detail-panel"><h2><%= locale === 'tr' ? 'Eğitim' : 'Education' %></h2><% profile.education.forEach(item => { %><article><h3><%= item.institution %></h3><p><%= item.program || '' %><%= item.startYear ? ' · ' + item.startYear : '' %><%= item.endYear ? '–' + item.endYear : '' %></p></article><% }) %></section><% } %>
<% if (site.approachSteps && site.approachSteps.length) { %><section class="focus-section"><div class="section-heading"><div><p class="eyebrow">02 / APPROACH</p><h2><%= site.approachTitle || (locale === 'tr' ? 'Nasıl çalışıyorum?' : 'How I work') %></h2></div></div><div class="focus-grid"><% site.approachSteps.forEach((step, i) => { %><article class="focus-card"><span class="card-index">0<%= i + 1 %></span><h3><%= step.title %></h3><p><%= step.text %></p></article><% }) %></div></section><% } %>
</main><%- include('../partials/portfolio-footer') %></body></html>
