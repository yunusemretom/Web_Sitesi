<!doctype html>
<html lang="<%= locale %>">
<head>
  <%- include('../partials/portfolio-head') %>
  <title><%= t.nav.about %> — Yunus Emre Tom</title>
</head>
<body class="portfolio-v2">
<%- include('../partials/portfolio-nav') %>
<main class="shell inner-page">
  <p class="eyebrow">01 / <%= locale === 'tr' ? 'HAKKIMDA' : 'ABOUT' %></p>
  <h1 class="page-title"><%= site.aboutTitle || t.aboutTitle %></h1>

  <div class="about-layout">
    <div class="about-copy">
      <p><%= profile.biography || t.aboutText %></p>
      <% if (profile.additionalBiography || t.aboutText2) { %>
        <p><%= profile.additionalBiography || t.aboutText2 %></p>
      <% } %>

      <div class="about-facts">
        <% if (profile.location) { %>
          <div>
            <span><%= locale === 'tr' ? 'KONUM' : 'BASED IN' %></span>
            <strong><%= profile.location %></strong>
          </div>
        <% } %>
        <% if (profile.university) { %>
          <div>
            <span><%= locale === 'tr' ? 'ÜNİVERSİTE' : 'UNIVERSITY' %></span>
            <strong><%= profile.university %></strong>
          </div>
        <% } %>
        <% if (profile.focusAreas && profile.focusAreas.length) { %>
          <div>
            <span><%= locale === 'tr' ? 'ODAK ALANLARI' : 'FOCUS' %></span>
            <strong><%= profile.focusAreas.join(' · ') %></strong>
          </div>
        <% } %>
      </div>

      <% if (profile.cvUrl) { %>
        <p class="about-cv-action">
          <a class="button-quiet" href="<%= profile.cvUrl %>" target="_blank" rel="noopener noreferrer">
            <%= locale === 'tr' ? 'Özgeçmişi görüntüle' : 'View CV' %> ↗
          </a>
        </p>
      <% } %>
    </div>

    <figure class="portrait-placeholder">
      <% const primaryPortrait = profile.portraitUrl || '/imgs/profile.png'; %>
      <img
        class="portrait-img"
        src="<%= primaryPortrait %>"
        data-fallback-src="/imgs/profile.png"
        alt="<%= profile.portraitAlt || profile.name || 'Yunus Emre Tom' %>"
        loading="eager"
        decoding="async"
        style="object-position: <%= profile.portraitObjectPosition || '50% 22%' %>"
      >
      <div class="portrait-fallback" aria-hidden="true">
        <strong>YT</strong>
        <small><%= profile.name || 'YUNUS EMRE TOM' %></small>
      </div>
      <figcaption class="portrait-badge"><%= locale === 'tr' ? 'PROFİL / PORTRE' : 'PROFILE / PORTRAIT' %></figcaption>
    </figure>
  </div>

  <% if (profile.skills && profile.skills.length) { %>
    <section class="detail-panel">
      <h2><%= locale === 'tr' ? 'Yetkinlikler' : 'Skills' %></h2>
      <div class="tag-list">
        <% profile.skills.forEach(skill => { %>
          <span><%= skill %></span>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (profile.education && profile.education.length) { %>
    <section class="detail-panel">
      <h2><%= locale === 'tr' ? 'Eğitim' : 'Education' %></h2>
      <% profile.education.forEach(item => { %>
        <article class="education-item">
          <h3><%= item.institution %></h3>
          <p><%= item.program || '' %><%= item.startYear ? ' · ' + item.startYear : '' %><%= item.endYear ? '–' + item.endYear : '' %></p>
        </article>
      <% }) %>
    </section>
  <% } %>

  <% if (site.approachSteps && site.approachSteps.length) { %>
    <section class="focus-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / <%= locale === 'tr' ? 'YAKLAŞIM' : 'APPROACH' %></p>
          <h2><%= site.approachTitle || (locale === 'tr' ? 'Nasıl çalışıyorum?' : 'How I work') %></h2>
        </div>
      </div>
      <div class="focus-grid">
        <% site.approachSteps.forEach((step, i) => { %>
          <% const idxStr = String(i + 1).padStart(2, '0'); %>
          <article class="focus-card" style="--card-i:<%= i %>">
            <div class="focus-card-head">
              <span class="card-index"><span class="card-index-dot" aria-hidden="true"></span><%= idxStr %></span>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </div>
            <h3><%= step.title %></h3>
            <p><%= step.text %></p>
            <div class="focus-card-footer" aria-hidden="true">
              <span class="focus-card-bar"></span>
              <span class="focus-card-watermark"><%= idxStr %></span>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>
<%- include('../partials/portfolio-footer') %>
</body>
</html>
