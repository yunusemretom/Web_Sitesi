<!doctype html>
<html lang="<%= locale %>">
<head>
  <%- include('../partials/portfolio-head') %>
  <title><%= t.nav.competitions %> — Yunus Emre Tom</title>
</head>
<body class="portfolio-v2">
<%- include('../partials/portfolio-nav') %>
<main class="shell inner-page">
  <p class="eyebrow">03 / <%= locale === 'tr' ? 'TAKIM DENEYİMİ' : 'TEAM EXPERIENCE' %></p>
  <h1 class="page-title"><%= site.competitionsTitle || t.competitionsTitle %></h1>
  <p class="page-intro"><%= site.competitionsIntro || t.competitionsIntro %></p>

  <div class="competition-list">
    <% competitions.forEach((item, i) => { %>
      <article class="competition-row">
        <span class="card-index"><%= String(i + 1).padStart(2, '0') %></span>
        <div>
          <% if (item.coverImageUrl) { %>
            <img class="competition-cover" src="<%= item.coverImageUrl %>" alt="<%= item.title %>" loading="lazy">
          <% } %>
          <h2><%= item.title %></h2>
          <% if (item.description) { %>
            <p><%= item.description %></p>
          <% } %>
          <% if (item.team) { %>
            <p class="comp-meta"><strong><%= locale === 'tr' ? 'Takım:' : 'Team:' %></strong> <%= item.team %></p>
          <% } %>
          <% if (item.role) { %>
            <p class="comp-meta"><strong><%= locale === 'tr' ? 'Rolüm:' : 'My role:' %></strong> <%= item.role %></p>
          <% } %>
          <% if (item.result || item.competitionStage || item.year) { %>
            <p class="comp-meta">
              <%= [item.result, item.competitionStage, item.year].filter(Boolean).join(' · ') %>
            </p>
          <% } %>
          <% if (item.link) { %>
            <a class="text-link" href="<%= item.link %>" target="_blank" rel="noopener noreferrer">
              <%= locale === 'tr' ? 'Yarışmayı incele' : 'View competition' %> ↗
            </a>
          <% } %>
        </div>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </article>
    <% }) %>
  </div>
</main>
<%- include('../partials/portfolio-footer') %>
</body>
</html>
