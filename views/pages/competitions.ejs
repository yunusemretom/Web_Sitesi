<!doctype html><html lang="<%= locale %>"><head><%- include('../partials/portfolio-head') %><title><%= t.nav.competitions %> — Yunus Emre Tom</title></head><body class="portfolio-v2"><%- include('../partials/portfolio-nav') %><main class="shell inner-page"><p class="eyebrow">03 / TEAM EXPERIENCE</p><h1 class="page-title"><%= site.competitionsTitle || t.competitionsTitle %></h1><p class="page-intro"><%= site.competitionsIntro || t.competitionsIntro %></p><div class="competition-list"><% competitions.forEach((item, i) => { %><article class="competition-row"><span class="card-index">0<%= i + 1 %></span><div><h2><%= item.title %></h2><p><%= item.description %></p><% if (item.role) { %><p><strong><%= locale === 'tr' ? 'Rolüm:' : 'My role:' %></strong> <%= item.role %></p><% } %><% if (item.result || item.year) { %><p><%= item.result || '' %><%= item.result && item.year ? ' · ' : '' %><%= item.year || '' %></p><% } %><% if (item.link) { %><a class="text-link" href="<%= item.link %>" target="_blank" rel="noopener"><%= locale === 'tr' ? 'Yarışmayı incele' : 'View competition' %> ↗</a><% } %></div><span class="row-arrow">↗</span></article><% }) %></div></main><%- include('../partials/portfolio-footer') %></body></html>
