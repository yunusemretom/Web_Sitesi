<!doctype html><html lang="<%= locale %>"><head><%- include('../partials/portfolio-head') %><title><%= project.title %> — Yunus Emre Tom</title></head><body class="portfolio-v2"><%- include('../partials/portfolio-nav') %><main class="shell inner-page"><a class="back-link" href="<%= routeFor('projects', locale) %>">← <%= t.backToProjects %></a><p class="eyebrow">PROJECT / <%= project.category || 'ENGINEERING' %></p><h1 class="page-title"><%= project.title %></h1><p class="page-intro"><%= project.summary %></p><% if (project.coverImageUrl) { %><div class="project-detail-cover"><img src="<%= project.coverImageUrl %>" alt="<%= project.title %>" style="width:100%;height:auto;object-fit:cover"></div><% } %><section class="detail-panel"><h2><%= locale === 'tr' ? 'Çalışmanın kapsamı' : 'Project overview' %></h2><p><%= project.contribution || project.description || project.summary %></p><% if (project.description && project.contribution) { %><p><%= project.description %></p><% } %><% if (project.technologies && project.technologies.length) { %><h3><%= locale === 'tr' ? 'Teknolojiler ve alanlar' : 'Technologies & domains' %></h3><div class="tag-list"><% project.technologies.forEach(tag => { %><span><%= tag %></span><% }) %></div><% } %><div class="hero-actions"><% if (project.repositoryUrl) { %><a class="button-quiet" href="<%= project.repositoryUrl %>" target="_blank" rel="noopener">Repository ↗</a><% } %><% if (project.demoUrl) { %><a class="button-primary" href="<%= project.demoUrl %>" target="_blank" rel="noopener">Demo ↗</a><% } %></div></section><% if (project.galleryUrls && project.galleryUrls.length) { %><div class="project-gallery"><% project.galleryUrls.forEach(url => { %><img src="<%= url %>" alt="<%= project.title %> gallery image" style="max-width:100%;height:auto"><% }) %></div><% } %></main><%- include('../partials/portfolio-footer') %></body></html>
