<!doctype html><html lang="<%= locale %>"><head><%- include('../partials/portfolio-head') %><title><%= project.title %> — Yunus Emre Tom</title></head><body class="portfolio-v2"><%- include('../partials/portfolio-nav') %><main class="shell inner-page"><a class="back-link" href="<%= routeFor('projects', locale) %>">← <%= t.backToProjects %></a><p class="eyebrow">PROJECT / <%= project.category || 'ENGINEERING' %></p><h1 class="page-title"><%= project.title %></h1><p class="page-intro"><%= project.summary %></p><section class="detail-panel"><h2><%= locale === 'tr' ? 'Çalışmanın kapsamı' : 'Project overview' %></h2><p><%= project.contribution || project.description || project.summary %></p><% if (project.technologies && project.technologies.length) { %><h3><%= locale === 'tr' ? 'Teknolojiler ve alanlar' : 'Technologies & domains' %></h3><div class="tag-list"><% project.technologies.forEach(tag => { %><span><%= tag %></span><% }) %></div><% } %></section></main><%- include('../partials/portfolio-footer') %></body></html>
