<!doctype html>
<html lang="<%= locale %>">
<head>
  <%- include('../partials/portfolio-head') %>
  <title><%= t.siteTitle %></title>
</head>
<body class="portfolio-v2">
<%- include('../partials/portfolio-nav') %>
<main>
  <section class="hero-v2 shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-pulse"></span><%= site.heroEyebrow || t.heroEyebrow %></p>
      <h1><%= site.heroTitle || t.heroTitle %></h1>
      <p class="hero-lead"><%= site.heroText || t.heroText %></p>
      <div class="hero-actions">
        <a class="button-primary" href="<%= routeFor('projects', locale) %>"><%= site.primaryButtonText || t.viewProjects %> <span>↗</span></a>
        <a class="button-quiet" href="<%= routeFor('contact', locale) %>"><%= site.secondaryButtonText || t.contactMe %></a>
      </div>
      <div class="hero-meta">
        <span><%= profile.location || t.locationValue %></span>
        <span>·</span>
        <span><%= site.collaborationLabel || (locale === 'tr' ? 'İŞ BİRLİĞİNE AÇIK' : 'OPEN TO COLLABORATION') %></span>
      </div>
    </div>

    <div class="hero-visual" aria-label="<%= locale === 'tr' ? 'Mühendislik portfolyo görseli' : 'Engineering portfolio visual' %>">
      <div class="orbit orbit-one" aria-hidden="true">
        <svg class="orbit-svg" viewBox="0 0 340 230" aria-hidden="true">
          <ellipse class="orbit-trail orbit-trail-cyan" cx="170" cy="115" rx="169" ry="114" pathLength="100" />
        </svg>
        <span class="orbit-satellite sat-one" aria-hidden="true"></span>
      </div>
      <div class="orbit orbit-two" aria-hidden="true">
        <svg class="orbit-svg" viewBox="0 0 430 300" aria-hidden="true">
          <ellipse class="orbit-trail orbit-trail-lime" cx="215" cy="150" rx="214" ry="149" pathLength="100" />
        </svg>
        <span class="orbit-satellite sat-two" aria-hidden="true"></span>
      </div>
      <div class="visual-core">
        <span class="core-monogram">YT</span>
        <small class="core-caption">
          <span class="engineering-word" aria-label="ENGINEERING"><% 'ENGINEERING'.split('').forEach((ch, idx) => { %><span class="eng-char" style="--char-i:<%= idx %>" aria-hidden="true"><%= ch %></span><% }) %></span>
          <span class="portfolio-word">PORTFOLIO</span>
        </small>
      </div>
      <div class="visual-chip chip-a">EMBEDDED</div>
      <div class="visual-chip chip-b">UAV SYSTEMS</div>
      <div class="visual-chip chip-c">PCB DESIGN</div>
    </div>
  </section>

  <section class="focus-section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / <%= locale === 'tr' ? 'ÇALIŞMA ALANLARI' : 'CAPABILITIES' %></p>
        <h2><%= site.focusTitle || t.focusTitle %></h2>
        <p><%= site.focusIntro || t.focusIntro %></p>
      </div>
    </div>
    <% const focusItems = site.homeFocus && site.homeFocus.length ? site.homeFocus : t.focus; %>
    <div class="focus-grid">
      <% focusItems.forEach((item, i) => { %>
        <% const idxStr = String(i + 1).padStart(2, '0'); %>
        <article class="focus-card" style="--card-i:<%= i %>">
          <div class="focus-card-head">
            <div class="focus-icon-box" aria-hidden="true">
              <% if (i % 4 === 0) { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"/>
                  <circle cx="12" cy="12" r="2.5"/>
                </svg>
              <% } else if (i % 4 === 1) { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="6" y="6" width="12" height="12" rx="1.5"/>
                  <rect x="9.5" y="9.5" width="5" height="5" rx="0.5"/>
                  <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>
                </svg>
              <% } else if (i % 4 === 2) { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3.5"/>
                  <path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12"/>
                </svg>
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                  <polyline points="2 12 12 17 22 12"/>
                  <polyline points="2 17 12 22 22 17"/>
                </svg>
              <% } %>
            </div>
            <div class="focus-card-meta">
              <span class="card-index"><span class="card-index-dot" aria-hidden="true"></span><%= idxStr %></span>
              <span class="card-arrow" aria-hidden="true">↗</span>
            </div>
          </div>
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
          <div class="focus-card-footer" aria-hidden="true">
            <span class="focus-card-bar"></span>
            <span class="focus-card-watermark"><%= idxStr %></span>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="projects-section shell">
    <div class="section-heading section-heading-row">
      <div>
        <p class="eyebrow">02 / <%= locale === 'tr' ? 'SEÇİLİ ÇALIŞMALAR' : 'SELECTED WORK' %></p>
        <h2><%= site.featuredTitle || t.featuredTitle %></h2>
        <p><%= site.featuredIntro || t.featuredIntro %></p>
      </div>
      <a class="text-link" href="<%= routeFor('projects', locale) %>"><%= t.allProjects %> ↗</a>
    </div>
    <% if (projects && projects.length) { %>
      <div class="project-grid">
        <% projects.forEach((project, index) => { %>
          <%- include('../partials/project-card', { project, index, locale, t, routeFor }) %>
        <% }) %>
      </div>
    <% } else { %>
      <p><%= t.noProjects %></p>
    <% } %>
  </section>

  <section class="closing-cta shell">
    <p class="eyebrow">03 / <%= locale === 'tr' ? 'SONRAKİ ADIM' : 'NEXT STEP' %></p>
    <h2><%= site.contactTitle || t.contactTitle %></h2>
    <p><%= site.contactText || t.contactText %></p>
    <a class="button-primary" href="<%= routeFor('contact', locale) %>"><%= site.secondaryButtonText || t.contactMe %> <span>↗</span></a>
  </section>
</main>
<%- include('../partials/portfolio-footer') %>
</body>
</html>
