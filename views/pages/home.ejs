<!doctype html>
<html lang="<%= locale %>"><head><%- include('../partials/portfolio-head') %><title><%= t.siteTitle %></title></head><body class="portfolio-v2">
<%- include('../partials/portfolio-nav') %>
<main>
<section class="hero-v2 shell">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-pulse"></span><%= t.heroEyebrow %></p>
    <h1><%= t.heroTitle %></h1>
    <p class="hero-lead"><%= t.heroText %></p>
    <div class="hero-actions"><a class="button-primary" href="<%= routeFor('projects', locale) %>"><%= t.viewProjects %> <span>↗</span></a><a class="button-quiet" href="<%= routeFor('contact', locale) %>"><%= t.contactMe %></a></div>
    <div class="hero-meta"><span>ANKARA, TR</span><span>·</span><span>OPEN TO COLLABORATION</span></div>
  </div>
  <div class="hero-visual" aria-label="Engineering visual">
    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="visual-core"><span>YT</span><small>ENGINEERING<br>PORTFOLIO</small></div>
    <div class="visual-chip chip-a">EMBEDDED</div><div class="visual-chip chip-b">UAV SYSTEMS</div><div class="visual-chip chip-c">PCB DESIGN</div>
  </div>
</section>
<section class="focus-section shell">
  <div class="section-heading"><div><p class="eyebrow">01 / CAPABILITIES</p><h2><%= t.focusTitle %></h2><p><%= t.focusIntro %></p></div></div>
  <div class="focus-grid"><% t.focus.forEach((item, i) => { %><article class="focus-card"><span class="card-index">0<%= i + 1 %></span><h3><%= item.title %></h3><p><%= item.text %></p><span class="card-arrow">↗</span></article><% }) %></div>
</section>
<section class="projects-section shell">
  <div class="section-heading section-heading-row"><div><p class="eyebrow">02 / SELECTED WORK</p><h2><%= t.featuredTitle %></h2><p><%= t.featuredIntro %></p></div><a class="text-link" href="<%= routeFor('projects', locale) %>"><%= t.allProjects %> ↗</a></div>
  <% if (projects.length) { %><div class="project-grid"><% projects.forEach((project, i) => { %><a class="project-tile" href="<%= routeFor('projects', locale) %>/<%= project.slug %>"><div class="tile-top"><span>0<%= i + 1 %> / PROJECT</span><span><%= project.category || 'ENGINEERING' %></span></div><div class="tile-art"><div class="tile-art-lines"></div><span><%= project.category || 'SYSTEM' %></span></div><h3><%= project.title %></h3><p><%= project.summary %></p><div class="tile-bottom"><span><%= t.projectStatus[project.status] || project.status %></span><span>↗</span></div></a><% }) %></div><% } else { %><p><%= t.noProjects %></p><% } %>
</section>
<section class="closing-cta shell"><p class="eyebrow">03 / NEXT STEP</p><h2><%= t.contactTitle %></h2><p><%= t.contactText %></p><a class="button-primary" href="<%= routeFor('contact', locale) %>"><%= t.contactMe %> ↗</a></section>
</main>
<%- include('../partials/portfolio-footer') %></body></html>
