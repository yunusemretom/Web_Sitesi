# Sanity CMS Configuration
SANITY_PROJECT_ID=0j1jarsg
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01
# Optional: Only needed if the Sanity dataset is set to private (read-only token, server-side only)
SANITY_API_READ_TOKEN=

# GitHub Integration Configuration (Server-side only)
